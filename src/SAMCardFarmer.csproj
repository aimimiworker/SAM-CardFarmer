<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>net48;net472</TargetFrameworks>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>SAM.CardFarmer</AssemblyName>
    <RootNamespace>SAMCardFarmer</RootNamespace>
    <Company>Open Source Community</Company>
    <Product>SAM Card Farmer</Product>
    <Description>Lightweight fan-made Steam Trading Card idling companion for Steam Achievement Manager (SAM) — zero download, hidden background mode, safe offline HTML parser.</Description>
    <Version>1.0.1</Version>
    <FileVersion>1.0.1.0</FileVersion>
    <AssemblyVersion>1.0.1.0</AssemblyVersion>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48' or '$(TargetFramework)' == 'net472'">
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

</Project>
